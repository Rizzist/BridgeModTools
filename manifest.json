{
  "manifest_version": 3,
  "minimum_chrome_version": "133",
  "name": "BridgeModTools",
  "version": "2.5.0",
  "description": "Locally preserves rendered Discord messages and cached media, then restores deleted rows in a Discord-style layout.",
  "permissions": ["storage", "offscreen", "unlimitedStorage", "scripting", "webNavigation"],
  "host_permissions": [
    "https://discord.com/*",
    "https://cdn.discordapp.com/*",
    "https://media.discordapp.net/*",
    "https://images-ext-1.discordapp.net/*",
    "https://images-ext-2.discordapp.net/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "BridgeModTools",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://discord.com/*"],
      "js": ["src/core.js", "src/protocol.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "media/view.html",
        "media/view.css",
        "media/view.js",
        "src/core.js",
        "src/protocol.js",
        "src/media-store.js"
      ],
      "matches": ["https://discord.com/*"],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src https:; frame-ancestors 'self' https://discord.com"
  }
}
